{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "ESNext",
    "esModuleInterop": true,
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,
    "strict": true, /* Enables all strict type-checking options */
    "exactOptionalPropertyTypes": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "allowJs": true,
    "incremental": true,
    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "resolveJsonModule": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx", //Le indican a TypeScript que debe revisar absolutamente todos los archivos de código (.ts y .tsx)
    ".next/types/**/*.ts",
    "dist/types/**/*.ts",
    "dist/dev/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ], //Permite que TypeScript reconozca los tipos avanzados que Next.js genera en tiempo de desarrollo
  "exclude": [
    "node_modules"
  ]
}
